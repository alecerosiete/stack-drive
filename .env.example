# ─────────────────────────────────────────────────────────────────────────────
# StackDrive API — configuración de entorno
# Copia este archivo a `.env` y rellena los valores. `.env` está en .gitignore:
# nunca se versiona, porque contiene el secreto del cliente de Google y las
# claves de cifrado de los refresh_token.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000

# Orígenes del panel web autorizados (separados por comas).
CORS_ORIGINS=http://localhost:5173

# ── Base de datos ───────────────────────────────────────────────────────────
DATABASE_URL="postgresql://stackdrive:stackdrive@localhost:5432/stackdrive?schema=public"

# ── Redis (cola de transferencias entre cuentas) ────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=stackdrive

# ── Sesiones de la plataforma ───────────────────────────────────────────────
# Mínimo 32 caracteres. Genera uno con: npm run keygen
JWT_SECRET=cambiame-por-un-secreto-largo-y-aleatorio-de-32-chars
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12

# ── Credenciales OAuth del proyecto de Google Cloud ─────────────────────────
# Son GLOBALES de la aplicación: una sola pareja client_id/client_secret sirve
# para todas las cuentas de Google que vinculen todos los usuarios.
# Google Cloud Console › APIs y servicios › Credenciales › ID de cliente OAuth
# (tipo "Aplicación web"). Habilita además la Google Drive API.
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx

# Debe coincidir EXACTAMENTE con el "URI de redireccionamiento autorizado"
# dado de alta en la consola de Google, incluido el puerto.
GOOGLE_REDIRECT_URI=http://localhost:3000/google/callback

# Scopes solicitados. `.../auth/drive` da control total del Drive del usuario
# (ver y organizar archivos preexistentes) y es un scope RESTRINGIDO: Google
# exige verificación con auditoría de seguridad antes de superar los 100
# usuarios de prueba. Para un alcance menor y sin auditoría, sustitúyelo por
# `https://www.googleapis.com/auth/drive.file`, que solo accede a lo que crea
# la propia aplicación.
GOOGLE_SCOPES="https://www.googleapis.com/auth/drive https://www.googleapis.com/auth/userinfo.email https://www.googleapis.com/auth/userinfo.profile openid"

# A dónde devolver el navegador tras el consentimiento. Si se deja vacío, el
# callback responde JSON (cómodo para probar con curl).
POST_LINK_REDIRECT_URL=http://localhost:5173/

# ── Cifrado de los refresh_token (AES-256-GCM) ──────────────────────────────
# Clave de 32 bytes en base64. Genera una con: npm run keygen
# ¡Si pierdes esta clave, los refresh_token guardados son irrecuperables y
# todos los usuarios tendrán que volver a vincular sus cuentas!
TOKEN_ENCRYPTION_KEY=

# Rotación de clave (opcional). Al rotar, declara todas las versiones y marca
# la activa; los sobres antiguos se re-cifran solos al usarse.
#   TOKEN_ENCRYPTION_KEYS="1:<base64>,2:<base64>"
#   TOKEN_ENCRYPTION_KEY_VERSION=2

# ── Comportamiento frente a la API de Google ────────────────────────────────
GOOGLE_MAX_RETRIES=3
GOOGLE_RETRY_BASE_DELAY_MS=300
# Margen con el que se considera caducado un access_token antes de que lo esté.
ACCESS_TOKEN_SKEW_SECONDS=60
# Tamaño máximo por subida (bytes). Por defecto 5 GB.
UPLOAD_MAX_BYTES=5368709120

# ── Redistribución por cuota ────────────────────────────────────────────────
# Fracción de cuota a partir de la cual una cuenta se considera "bajo presión".
REBALANCE_THRESHOLD=0.9
REBALANCE_MAX_MOVES=25
REBALANCE_CANDIDATE_SAMPLE=200

# Transferencias simultáneas por worker y reintentos por transferencia.
TRANSFER_CONCURRENCY=2
TRANSFER_ATTEMPTS=3

# Vigilancia periódica de cuotas: SOLO mide y guarda la foto en
# `quota_snapshots`; nunca mueve archivos por su cuenta.
QUOTA_WATCH_ENABLED=false
QUOTA_WATCH_CRON="0 */6 * * *"
